{
  "name": "cobblerealm-launcher",
  "version": "2.0.0",
  "description": "Launcher officiel CobbleRealm",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyrian290606/CobbleRealm-Launcher.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "node tools/build.js",
    "release": "node tools/build.js --publish",
    "test": "node test/phase1.test.js && node test/publish.test.js && node test/updater.test.js && node test/runtime.test.js && node test/support.test.js && node test/auth.test.js && node test/infos.test.js && node test/animations.test.js && node test/windowstate.test.js"
  },
  "author": "CobbleRealm",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "electron-updater": "6.8.10",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "fr.cobblerealm.launcher",
    "productName": "CobbleRealm Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "minecraftAuth.js",
      "fabric.js",
      "runtime.js",
      "launcherUpdates.js",
      "changelog.js",
      "serverStatus.js",
      "CHANGELOG.md",
      "playerErrors.js",
      "support.js",
      "windowState.js",
      "index.html",
      "icon.ico",
      "assets/**/*",
      "updater/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "cyrian290606",
        "repo": "CobbleRealm-Launcher",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CobbleRealm Launcher",
      "artifactName": "CobbleRealm-Launcher-Setup.exe"
    }
  }
}
