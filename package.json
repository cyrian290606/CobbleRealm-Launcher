{
  "name": "cobblerealm-launcher",
  "version": "1.0.6",
  "description": "Launcher officiel CobbleRealm",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "CobbleRealm",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "adm-zip": "^0.6.1",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2"
  },
  "build": {
    "appId": "fr.cobblerealm.launcher",
    "productName": "CobbleRealm Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CobbleRealm Launcher"
    }
  }
}
